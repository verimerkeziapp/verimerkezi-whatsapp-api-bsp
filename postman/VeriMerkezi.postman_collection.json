{
  "info": {
    "name": "Veri Merkezi — WhatsApp Business API",
    "description": "Resmî Postman koleksiyonu — Veri Merkezi BSP altyapısı için tüm endpoint'ler.\n\n## Kurulum\n1. Koleksiyonu Postman'e import edin\n2. Environment oluşturun:\n   - `api_key`: vmk_live_xxx\n   - `phone_number_id`: bağlı WhatsApp numaranızın ID'si\n   - `test_recipient`: kendi test numaranız (905551112233)\n3. Hazırsınız!\n\n## Dokümantasyon\nhttps://api.verimerkezi.app/docs/wa",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{api_key}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "https://api.verimerkezi.app/wa" },
    { "key": "api_key", "value": "vmk_live_REPLACE_ME" },
    { "key": "phone_number_id", "value": "1234567890" },
    { "key": "test_recipient", "value": "905551112233" }
  ],
  "item": [
    {
      "name": "1. Hesap",
      "item": [
        {
          "name": "GET /me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/me", "host": ["{{base_url}}"], "path": ["me"] }
          }
        },
        {
          "name": "GET /numbers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/numbers", "host": ["{{base_url}}"], "path": ["numbers"] }
          }
        }
      ]
    },
    {
      "name": "2. Mesajlar",
      "item": [
        {
          "name": "POST /messages — Text",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"text\": \"Merhaba! Test mesajı.\"\n}"
            },
            "url": { "raw": "{{base_url}}/messages", "host": ["{{base_url}}"], "path": ["messages"] }
          }
        },
        {
          "name": "POST /messages — Template",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"template\": {\n    \"name\": \"hosgeldin\",\n    \"language\": { \"code\": \"tr\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [{ \"type\": \"text\", \"text\": \"Ahmet\" }]\n      }\n    ]\n  }\n}"
            },
            "url": { "raw": "{{base_url}}/messages", "host": ["{{base_url}}"], "path": ["messages"] }
          }
        }
      ]
    },
    {
      "name": "3. Şablonlar",
      "item": [
        {
          "name": "GET /templates",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/templates", "host": ["{{base_url}}"], "path": ["templates"] }
          }
        }
      ]
    },
    {
      "name": "4. Kişiler",
      "item": [
        {
          "name": "GET /contacts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/contacts?limit=50",
              "host": ["{{base_url}}"],
              "path": ["contacts"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          }
        },
        {
          "name": "POST /contacts",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"905551234567\",\n  \"name\": \"Ayşe Müşteri\",\n  \"email\": \"ayse@firma.com\",\n  \"tags\": [\"vip\", \"istanbul\"]\n}"
            },
            "url": { "raw": "{{base_url}}/contacts", "host": ["{{base_url}}"], "path": ["contacts"] }
          }
        },
        {
          "name": "POST /contacts/bulk",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacts\": [\n    { \"phone\": \"905551234567\", \"name\": \"Ayşe Müşteri\", \"email\": \"ayse@firma.com\", \"tags\": [\"vip\"] },\n    { \"phone\": \"905559876543\", \"name\": \"Mehmet Yılmaz\", \"company\": \"Yılmaz Ltd.\" }\n  ],\n  \"skip_duplicates\": true,\n  \"country_code\": \"90\"\n}"
            },
            "url": { "raw": "{{base_url}}/contacts/bulk", "host": ["{{base_url}}"], "path": ["contacts", "bulk"] }
          }
        }
      ]
    },
    {
      "name": "5. Krediler",
      "item": [
        {
          "name": "GET /credit/balance",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/credit/balance", "host": ["{{base_url}}"], "path": ["credit", "balance"] }
          }
        },
        {
          "name": "GET /credit/packages",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/credit/packages", "host": ["{{base_url}}"], "path": ["credit", "packages"] }
          }
        },
        {
          "name": "GET /credit/usage",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/credit/usage?days=30",
              "host": ["{{base_url}}"],
              "path": ["credit", "usage"],
              "query": [{ "key": "days", "value": "30" }]
            }
          }
        },
        {
          "name": "GET /credit/transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/credit/transactions?limit=50",
              "host": ["{{base_url}}"],
              "path": ["credit", "transactions"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "cursor", "value": "", "disabled": true },
                { "key": "type", "value": "", "disabled": true },
                { "key": "source", "value": "", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
