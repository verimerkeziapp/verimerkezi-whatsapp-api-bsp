{
  "info": {
    "name": "Veri Merkezi — WhatsApp Business API",
    "description": "Resmî Postman koleksiyonu — Veri Merkezi BSP altyapısı için tüm endpoint'ler.\n\n## Kurulum\n1. Koleksiyonu Postman'e import edin\n2. Environment oluşturun:\n   - `api_key`: vmk_live_xxx\n   - `phone_number_id`: bağlı WhatsApp numaranızın ID'si\n   - `test_recipient`: kendi test numaranız (905551112233)\n3. Hazırsınız!\n\n## Dokümantasyon\nhttps://api.verimerkezi.app/docs/wa",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.verimerkezi.app/wa"
    },
    {
      "key": "api_key",
      "value": "vmk_live_REPLACE_ME"
    },
    {
      "key": "phone_number_id",
      "value": "1234567890"
    },
    {
      "key": "test_recipient",
      "value": "905551112233"
    },
    {
      "key": "media_id",
      "value": "12345"
    },
    {
      "key": "waba_id",
      "value": "1029384756"
    },
    {
      "key": "template_id",
      "value": "512"
    },
    {
      "key": "webhook_id",
      "value": "17"
    }
  ],
  "item": [
    {
      "name": "1. Hesap",
      "item": [
        {
          "name": "GET /me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "GET /numbers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/numbers",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "numbers"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Mesajlar",
      "item": [
        {
          "name": "POST /messages — Text",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"text\": \"Merhaba! Test mesajı.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ]
            }
          }
        },
        {
          "name": "POST /messages — Template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"template\": {\n    \"name\": \"hosgeldin\",\n    \"language\": { \"code\": \"tr\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [{ \"type\": \"text\", \"text\": \"Ahmet\" }]\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ]
            }
          }
        },
        {
          "name": "POST /messages — Dinamik URL Butonu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"template\": {\n    \"name\": \"sepet_kurtarma\",\n    \"language\": { \"code\": \"tr\" },\n    \"components\": [\n      { \"type\": \"body\", \"parameters\": [{ \"type\": \"text\", \"text\": \"Ahmet\" }] },\n      { \"type\": \"button\", \"sub_type\": \"url\", \"index\": 0, \"parameters\": [{ \"type\": \"text\", \"text\": \"d32eec6c,5cbd62f6\" }] }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ]
            }
          }
        },
        {
          "name": "POST /messages — Video (medya) gönder",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"type\": \"video\",\n  \"video\": {\n    \"link\": \"https://example.com/video.mp4\",\n    \"caption\": \"Tanıtım videosu\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ]
            }
          }
        },
        {
          "name": "POST /messages/read — Okundu + yazıyor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"message_id\": \"<wamid>\",\n  \"typing\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/messages/read",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages",
                "read"
              ]
            }
          }
        },
        {
          "name": "POST /messages — Alıntılı cevap",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"type\": \"text\",\n  \"text\": \"Yanıtınız için teşekkürler.\",\n  \"context\": {\n    \"message_id\": \"wamid.HBgL...\"\n  }\n}"
            }
          }
        },
        {
          "name": "POST /messages — Tepki (emoji)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ]
            },
            "description": "emoji \"\" gönderilirse tepki kaldırılır.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number_id\": \"{{phone_number_id}}\",\n  \"to\": \"{{test_recipient}}\",\n  \"type\": \"reaction\",\n  \"reaction\": {\n    \"message_id\": \"wamid.HBgL...\",\n    \"emoji\": \"👍\"\n  }\n}"
            }
          }
        },
        {
          "name": "GET /messages — Uzlaştırma (kaçan olaylar)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/messages?phone_number_id={{phone_number_id}}&since=2026-09-22T00:00:00Z&limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "messages"
              ],
              "query": [
                {
                  "key": "phone_number_id",
                  "value": "{{phone_number_id}}"
                },
                {
                  "key": "since",
                  "value": "2026-09-22T00:00:00Z"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "Okuma — kredi/kota tüketmez."
          }
        }
      ]
    },
