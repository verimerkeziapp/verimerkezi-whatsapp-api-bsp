# ─── Veri Merkezi WhatsApp API — Node.js .env örneği ───────────────
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env asla git'e commit edilmemeli — .gitignore'a eklendiğinden emin olun.

# API key (panel → API → "Yeni Anahtar Oluştur")
VM_API_KEY=vmk_live_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Üretim ortamı için aynen kalsın
VM_BASE_URL=https://api.verimerkezi.app/wa

# Hangi WhatsApp numarasından gönderim yapacaksınız
VM_PHONE_NUMBER_ID=1234567890

# ─── Webhook receiver için (webhook-receiver.js kullanılıyorsa) ─────
# createWebhook() çağrısında yanıtta dönen plain_secret (whsec_...)
# DIKKAT: Bu değer SADECE bir kez gösterilir — kaybederseniz yeniden oluşturun.
VM_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Receiver sunucu portu
PORT=3000
